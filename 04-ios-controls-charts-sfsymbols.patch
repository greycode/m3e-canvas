+  ko: ["월", "화", "수", "목", "금", "토", "일"],
+};
+const SLICES: Record<Lang, string[]> = {
+  ja: ["食費", "交通", "住居", "その他"],
+  en: ["Food", "Transport", "Home", "Other"],
+  zh: ["餐饮", "交通", "住房", "其他"],
+  ko: ["식비", "교통", "주거", "기타"],
+};
